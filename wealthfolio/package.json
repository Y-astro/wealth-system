{
  "name": "wealthfolio-app",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "workspaces": [
    "apps/frontend",
    "packages/*",
    "addons/*"
  ],
  "scripts": {
    "setup:env": "cp -n .env.example .env || true && cp -n .env.web.example .env.web || true",
    "audit:deps": "pnpm dlx depcheck apps/frontend",
    "dev": "turbo run dev --filter frontend",
    "dev:tauri": "pnpm --filter frontend dev:tauri",
    "dev:addons": "pnpm --filter frontend dev:addons",
    "dev:web": "dotenv -e .env.web -- concurrently -n \"rust,vite\" -c \"bgBlue.bold,bgMagenta.bold\" \"cargo watch -w crates -w apps/server -x 'run --manifest-path apps/server/Cargo.toml'\" \"pnpm --filter frontend dev\"",
    "build": "turbo run build --filter frontend",
    "build:tauri": "turbo run build:tauri --filter frontend",
    "build:types": "turbo run build:types",
    "build:addons": "turbo run build --filter './addons/*'",
    "bundle:addons": "pnpm -r --filter './addons/*' bundle",
    "preview": "pnpm --filter frontend preview",
    "tauri": "tauri",
    "test": "turbo run test --filter frontend",
    "test:watch": "pnpm --filter frontend test:watch",
    "test:ui": "pnpm --filter frontend test:ui",
    "test:coverage": "pnpm --filter frontend test:coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:quiet": "turbo run lint:quiet",
    "lint:root": "pnpm --filter frontend lint",
    "format": "prettier --write . && pnpm -r format",
    "format:check": "prettier --check . && pnpm -r format:check",
    "tsc": "tsc -b",
    "type-check": "turbo run type-check",
    "type-check:root": "pnpm --filter frontend type-check",
    "check": "pnpm format:check && turbo run lint:quiet && turbo run type-check",
    "publish:sdk": "cd packages/addon-sdk && npm publish --access public",
    "publish:ui": "cd packages/ui && npm publish --access public",
    "publish:addon-dev-tools": "cd packages/addon-dev-tools && npm publish --access public",
    "addon:create": "cd packages/addon-dev-tools && node cli.js create",
    "addon:dev": "cd packages/addon-dev-tools && node dev-server.js",
    "ingest": "python3 ../wealthmanager/process_all.py",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@tauri-apps/cli": "^2.10.0",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
